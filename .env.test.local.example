# Bluesky test credentials
# Create an App Password at: https://bsky.app → Settings → App Passwords
BLUESKY_TEST_HANDLE=yourhandle.bsky.social
BLUESKY_TEST_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Mastodon test credentials
# Create at: Your Instance → Settings → Development → New Application
# Required scopes: read, write:statuses, write:media
MASTODON_TEST_INSTANCE=mastodon.social
MASTODON_TEST_ACCESS_TOKEN=your_access_token_here

# Twitter/X test credentials
# Create at: https://developer.twitter.com → Your App → Keys & Tokens
TWITTER_TEST_BEARER_TOKEN=AAA...
TWITTER_TEST_API_KEY=your_api_key
TWITTER_TEST_API_SECRET=your_api_secret
TWITTER_TEST_ACCESS_TOKEN=your_access_token
TWITTER_TEST_ACCESS_TOKEN_SECRET=your_access_token_secret

# WordPress test blog
# Create App Password at: Users → Profile → Application Passwords
WP_TEST_URL=https://yourblog.com
WP_TEST_USERNAME=admin
WP_TEST_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Set to "true" to actually publish test posts (they will be live on your accounts!)
# Test posts are prefixed with [VIBE TEST] — delete them manually afterward.
INTEGRATION_POST=false
